tailscale up \
  --advertise-exit-node \
  --advertise-routes=192.169.1.0/24,192.168.1.0/24 \
 tailscale up \
  --advertise-exit-node \
  --advertise-routes=192.169.1.0/24,192.168.1.0/24 \
  --snat-subnet-routes=false
tailscale up \
  --advertise-exit-node \
  --advertise-routes=192.169.1.0/24,192.168.1.0/24 \
  --snat-subnet-routes=false \
  --accept-dns=false
tailscale up \
  --advertise-exit-node \
  --advertise-routes=192.168.1.0/24 \
  --snat-subnet-routes=false \
  --accept-dns=false
# 1) включён ли IP forwarding
cat /proc/sys/net/ipv4/ip_forward
# 2) статус Tailscale
tailscale status
# 3) exit node включён?
tailscale status --json | grep -E "ExitNode|AdvertisedRoutes|AllowedIPs" | head -10
# 4) правила NAT для tailscale
iptables -t nat -L POSTROUTING -n -v 2>/dev/null | grep -E "100\.|tailscale|MASQ" | head -5
tailscale up --advertise-exit-node --accept-dns=false
tailscale up --reset --advertise-exit-node --accept-dns=false
tailscale status
iptables: No chain/target/match by that name.
which iptables
iptables --version
opkg update
opkg install iptables-mod-mark
opkg list | grep -i "kmod-ipt\|iptables"
opkg install iptables --upgrade
 opkg install iptables --upgrade
opkg upgrade iptables
iptables -t nat -A POSTROUTING -s 100.64.0.0/10 -j MASQUERADE
iptables -t nat -D POSTROUTING -s 100.64.0.0/10 -j MASQUERADE
iptables -t nat -L POSTROUTING -n -v | head -10
iptables -L FORWARD -n -v | head -15
# это Entware, не NDMS — идём в NDMS CLI
exit
