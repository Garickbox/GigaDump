Package: wget-ssl
Version: 1.25.0-5
Depends: libc, libssp, librt, libpthread, libpcre2, zlib, libopenssl, librt
Provides: wget-ssl-any, wget, wget-any
Alternatives: 400:/opt/bin/wget:/opt/libexec/wget-ssl
Source: feeds/packages/net/wget
SourceName: wget
License: GPL-3.0-or-later
LicenseFiles: COPYING
Section: net
